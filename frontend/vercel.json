{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/user/:path*",
      "destination": "https://gym-microservices-production.up.railway.app/:path*"
    },
    {
      "source": "/api/payment/:path*",
      "destination": "https://payment-service-production-b780c96b.up.railway.app/:path*"
    },
    {
      "source": "/api/enrollment/:path*",
      "destination": "https://enrollment-service-production-60640b11.up.railway.app/:path*"
    },
    {
      "source": "/api/attendance/:path*",
      "destination": "https://attendance-service-production-b2ad6971.up.railway.app/:path*"
    },
    {
      "source": "/api/exercise/:path*",
      "destination": "https://exercise-service-production-83b2cddb.up.railway.app/:path*"
    },
    {
      "source": "/api/workout/:path*",
      "destination": "https://workout-service-production-5c17b4bd.up.railway.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
